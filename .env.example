# ============================================================
# CONTOH KONFIGURASI LINGKUNGAN - UPA BK UTM
# Salin file ini menjadi ".env" lalu sesuaikan nilainya.
# PENTING: Jangan pernah menyimpan kredensial asli di repositori.
# ============================================================

# --- Lingkungan aplikasi ---
# development = mode pengembangan (seed data & peringatan aktif)
APP_ENV=development

# Kunci rahasia untuk penandatanganan token sesi & token obrolan.
# GANTI dengan string acak panjang (mis. hasil: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=ganti-dengan-kunci-rahasia-acak-panjang

# Masa aktif token sesi admin (menit)
TOKEN_EXPIRE_MINUTES=480

# --- Database ---
# Pengembangan memakai SQLite. Struktur tabel dirancang agar mudah
# dimigrasi ke PostgreSQL (mis. postgresql+psycopg://user:pass@host/upabk)
DATABASE_URL=sqlite:///./upabk.db

# --- Akun admin pengembangan (hanya dibuat oleh seed / startup dev) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# --- Integrasi LLM ---
# mock             : penyedia simulasi offline, tanpa biaya, untuk pengembangan & pengujian
# openai_compatible: API kompatibel OpenAI (OpenAI, Azure OpenAI, Ollama, dll.)
LLM_PROVIDER=mock

# Konfigurasi penyedia openai_compatible (abaikan jika LLM_PROVIDER=mock)
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=20

# Pengaman privasi: HARUS diset "true" secara sadar (setelah review privasi &
# persetujuan kebijakan data UPA BK) sebelum data obrolan dikirim ke layanan eksternal.
LLM_ALLOW_EXTERNAL=false
